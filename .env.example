# OneBox runtime role. Unknown setting names fail startup rather than being ignored.
# Supported production roles are `api` and `automation_worker`; `combined` is a
# local-development convenience only.
ENVIRONMENT=development
SERVICE_ROLE=api
AUTOMATION_ENABLED=false

# PostgreSQL and Redis. Use `rediss://` and managed TLS in production.
DATABASE_URL=postgresql+asyncpg://onebox:REPLACE_WITH_PASSWORD@localhost:5432/onebox
REDIS_URL=redis://localhost:6379/0

# JWT verification contract. HS256 is the only supported algorithm.
# Generate a unique value, for example: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_RANDOM_32_BYTE_OR_LONGER_SECRET
ALGORITHM=HS256
JWT_ISSUER=https://issuer.example.invalid
JWT_AUDIENCE=onebox-api

# OAuth credentials are path fields. Mount files read-only; never commit them.
# Relative paths resolve from the repository root, not the process CWD.
GOOGLE_OAUTH_CLIENT_SECRETS=onebox_oauth.json
OAUTH_REDIRECT_URI=http://localhost:8000/agent/oauth/callback
FRONTEND_OAUTH_CALLBACK_URI=http://localhost:3000/mail/inbox

# Per-user OAuth tokens use AES-256-GCM with a read-only JSON keyring mapping
# key IDs to base64url 32-byte keys. Configure both variables together through
# your local secret mount/secret manager; never put key values in this file.
# OAUTH_TOKEN_KEYRING_PATH=/run/secrets/onebox-oauth-token-keyring.json
# OAUTH_TOKEN_ACTIVE_KEY_ID=replace-with-active-key-id

# Vertex/GenAI configuration. All three values are intentionally explicit.
GOOGLE_PROJECT_ID=REPLACE_WITH_GOOGLE_CLOUD_PROJECT_ID
GOOGLE_LOCATION=us-central1
GOOGLE_MODEL=gemini-2.0-flash-lite
# Leave blank only when Application Default Credentials are otherwise available.
GOOGLE_APPLICATION_CREDENTIALS=

# Browser access. A blank value disables cross-origin requests.
# Use a comma-separated list of exact origins, with no paths or wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gmail automation is disabled unless AUTOMATION_ENABLED=true and SERVICE_ROLE
# is `automation_worker` or `combined`. Set all values below before enabling it.
# `AUTOMATION_OWNER_ID` is the single OneBox user UUID for automation. The
# legacy name `AGENT_USER_ID_FOR_SERVICE` is accepted during this migration.
# AUTOMATION_OWNER_ID=00000000-0000-0000-0000-000000000000
# PUBSUB_TOPIC=projects/REPLACE_WITH_PROJECT_ID/topics/REPLACE_WITH_TOPIC
# PUBSUB_SUBSCRIPTION=projects/REPLACE_WITH_PROJECT_ID/subscriptions/REPLACE_WITH_SUBSCRIPTION
# PUBSUB_PUSH_AUDIENCE=https://api.example.invalid/mail/notifications
# PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=pubsub-push@REPLACE_WITH_PROJECT_ID.iam.gserviceaccount.com

# Ambiguous provider writes can be reconciled only by authenticated user UUIDs
# explicitly listed here. Leave unset to disable reconciliation fail-closed.
# PENDING_ACTION_OPERATOR_IDS=00000000-0000-0000-0000-000000000000
