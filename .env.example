# Google Pub/Sub
PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/YOUR_TOPIC
PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT/subscriptions/YOUR_SUB
# The audience configured on the Pub/Sub push subscription (normally its HTTPS endpoint URL).
PUBSUB_PUSH_AUDIENCE=https://your-domain.com/mail/notifications
# Service account configured on that subscription for authenticated push delivery.
PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=pubsub-push@YOUR_PROJECT.iam.gserviceaccount.com

# Google service account JSON file (ignored by git)
GOOGLE_APPLICATION_CREDENTIALS="executive-agent.json"

# PostgreSQL database URL
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"

# JWT secret key (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256

# Google OAuth client secrets JSON file (ignored by git)
GOOGLE_OAUTH_CLIENT_SECRETS="onebox_oauth.json"

# OAuth redirect URIs
OAUTH_REDIRECT_URI=https://your-domain.com/agent/oauth/callback
FRONTEND_OAUTH_CALLBACK_URI=https://your-domain.com/mail/inbox

# Comma-separated exact frontend origins permitted for browser API requests.
# Leave empty to disable cross-origin access (same-origin requests still work).
CORS_ALLOWED_ORIGINS=https://your-domain.com
