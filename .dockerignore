.github/
.agents/
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
tests/
scripts/
*.json
*.pem
*.key
*.crt
